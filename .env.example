# ===========================
# BASE DE DONNÉES
# ===========================
# DB_HOST=db en Docker Compose, DB_HOST=localhost pour un dev hors conteneur
DB_HOST=db
DB_PORT=5432
DB_DATABASE=prosartisan
DB_USERNAME=prosartisan
DB_PASSWORD=changeme_in_production
# true = interdit le repli SQLite (forcé automatiquement si APP_ENV=production)
DB_REQUIRE_POSTGRES=false
# true = journalise toutes les requêtes SQL (verbeux, dev uniquement)
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ===========================
# REDIS
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# ===========================
# QDRANT (Base Vectorielle)
# ===========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=connaissances_prosartisan

# Garde-fou « zéro hallucination » : score cosinus minimal d'un extrait pour
# servir de contexte au LLM. 0.71 = calibrage du 2026-11-21 pour
# gemini-embedding-001 (1536). Recalibrer après tout changement de modèle de
# vecteurs ou ajout important au corpus : `python -m app.scripts.calibrer_seuil_rag`.
RAG_MIN_SCORE=0.71
# Repli lexical (Gemini seul, sans embeddings) : part minimale des mots-clés de
# la question présents dans l'extrait, et nombre minimal de mots communs.
RAG_LEXICAL_MIN_SCORE=0.5
RAG_LEXICAL_MIN_OVERLAP=2
# Reformulation de la question (nouchi, dioula, baoulé, bété → français
# technique) pour la recherche uniquement ; un appel LLM court, mis en cache 7 j.
# Désactivée : au calibrage, elle réduisait l'écart entre questions couvertes et
# hors corpus sans gain. Si vous la réactivez, recalibrez avec --avec-reformulation.
RAG_REFORMULATION_REQUETE=false

# ===========================
# API LLM (Mistral AI & Google Gemini — Bascule Haute Disponibilité)
# ===========================
# Stratégie de sélection IA : "gemini" (Gemini prioritaire, défaut), "mistral"
# (Mistral prioritaire) ou "auto" (ressource la plus stable et disponible).
# Un choix fait dans le back-office (onglet Paramètres) prime sur cette valeur.
LLM_PROVIDER=gemini
LLM_FAILOVER_ENABLED=true
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# En production (APP_ENV=production), au moins une clé IA valide (Mistral ou
# Gemini) est obligatoire : sinon l'API refuse de démarrer (sans IA, le mode
# démonstration servirait des réponses génériques à de vrais artisans).
MISTRAL_API_KEY=your-mistral-key-here
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
LLM_MODEL=mistral-small-latest
LLM_VISION_MODEL=mistral-medium-latest
STT_MODEL=voxtral-mini-latest
TTS_MODEL=voxtral-mini-tts-2603
# Identifiant de la voix Voxtral TTS — préréglage "Marie - Neutral" (français)
# fourni par Mistral par défaut, aucun clonage requis. Autres préréglages :
# GET https://api.mistral.ai/v1/audio/voices?type=preset (dont fr_marie_sad,
# fr_marie_happy, fr_marie_excited, fr_marie_curious, fr_marie_angry).
TTS_VOICE_ID=5a271406-039d-46fe-835b-fbbb00eaf08d
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=mistral-embed

# Vecteurs de la recherche documentaire : "gemini" (défaut, gemini-embedding-001)
# ou "mistral" (mistral-embed, EMBEDDING_MODEL ci-dessus). Chaque modèle a sa
# collection Qdrant : Gemini écrit dans <QDRANT_COLLECTION>_gemini_<dimension>,
# Mistral garde QDRANT_COLLECTION. Changer de fournisseur ou de dimension impose
# de réindexer le corpus (python -m ingestion.pipeline ...) puis de recalibrer
# RAG_MIN_SCORE (python -m app.scripts.calibrer_seuil_rag).
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 768, 1536 ou 3072
GEMINI_EMBEDDING_DIMENSIONS=1536

# Google Gemini (Interactions API /v1beta/interactions — gemini-3.8-flash par défaut)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_THINKING_LEVEL=low

# ===========================
# PAIEMENT MOBILE MONEY
# ===========================
WAVE_API_KEY=wave_sk_live_your_key_here
# Secret du webhook générique (agrégateur, en-tête X-Signature)
MOBILE_MONEY_SECRET_KEY=your_hmac_secret_key_here
# demo (défaut) : simulateur fidèle des parcours officiels Wave / Orange Money,
# sans débit réel ; live : API officielles (identifiants ci-dessous requis).
PAYMENT_MODE=demo
# En production, le mode démo refuse tout paiement (503) sauf si true.
PAYMENT_DEMO_IN_PRODUCTION=false
# URL publique de l'API (URLs de retour et de notification opérateurs), HTTPS en live.
PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Wave Checkout : secret de signature des webhooks (portail marchand Wave).
WAVE_API_BASE=https://api.wave.com
WAVE_WEBHOOK_SECRET=your_wave_webhook_signing_secret
# Orange Money WebPay (developer.orange.com) — bac à sable : /dev/v1 + OUV ;
# production Côte d'Ivoire : /orange-money-webpay/ci/v1 + XOF.
ORANGE_API_BASE=https://api.orange.com
ORANGE_WEBPAY_PATH=/orange-money-webpay/dev/v1
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_MERCHANT_KEY=
ORANGE_CURRENCY=OUV
# CinetPay v1 API (docs.cinetpay.com)
CINETPAY_API_BASE=https://api.cinetpay.net
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_CURRENCY=XOF
CINETPAY_PAYMENT_METHOD=

# ===========================
# COMPTE ADMIN INITIAL (seed)
# ===========================
# En production, ADMIN_PASSWORD est obligatoire pour créer le compte admin.
# Hors production, un mot de passe de dev est utilisé si celui-ci est vide.
ADMIN_EMAIL=admin@prosartisan.ci
ADMIN_PASSWORD=

# ===========================
# APPLICATION
# ===========================
# APP_ENV=production impose des secrets forts + CORS explicite + APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme_generate_a_random_string
JWT_SECRET_KEY=changeme_generate_another_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
# Origines autorisées (séparées par des virgules). '*' interdit en production.
CORS_ALLOWED_ORIGINS=*
# Nombre de reverse proxies de confiance devant l'API (lecture de l'IP client
# dans X-Forwarded-For, de droite à gauche). 0 = connexion directe (dev).
# Caddy (docker-compose.prod.yml), Render, Cloud Run : 1.
TRUSTED_PROXY_HOPS=0

# ===========================
# QUOTAS FREEMIUM
# ===========================
# Quota gratuit par jour (UTC = heure d'Abidjan), compté dans Redis par
# utilisateur connecté ou par IP pour un visiteur anonyme. Remis à zéro chaque
# jour automatiquement ; les crédits achetés (Pack 50) s'y ajoutent.
MAX_QUESTIONS_GRATUITES_PAR_JOUR=5

# ===========================
# STOCKAGE FICHIERS
# ===========================
# Photos de chantier (chat_images/) et PDF admin (admin_docs/). Doit être un
# stockage persistant en production (volume Docker, disque persistant...).
UPLOAD_DIR=./uploads

# ===========================
# NOTIFICATIONS PUSH (Firebase Cloud Messaging — mobile, API HTTP v1)
# ===========================
# Chemin vers le JSON du compte de service Firebase (Console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée).
# Ne JAMAIS committer ce fichier (voir .gitignore) — placez-le par ex. dans
# secrets/firebase-service-account.json. Vide = provider push en no-op journalisé.
FCM_SERVICE_ACCOUNT_PATH=

# ===========================
# NOTIFICATIONS WEB PUSH (VAPID — chat_web)
# ===========================
# Fonctionne dès le départ avec la paire de dev intégrée par défaut (aucun
# compte tiers requis, contrairement à FCM). Régénérer en production avec :
#   python -c "from py_vapid import Vapid02; from cryptography.hazmat.primitives import serialization; import base64; v=Vapid02(); v.generate_keys(); priv=v.private_key.private_numbers().private_value.to_bytes(32,'big'); pub=v.public_key.public_bytes(encoding=serialization.Encoding.X962, format=serialization.PublicFormat.UncompressedPoint); print('VAPID_PRIVATE_KEY='+base64.urlsafe_b64encode(priv).rstrip(b'=').decode()); print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(pub).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=contact@prosartisan.ci

# Budgets audio par identité et jour UTC (indépendants des questions et des Pass)
AUDIO_STT_REQUESTS_PER_DAY=20
AUDIO_TTS_CHARS_PER_DAY=20000
# Révision intégrée automatiquement par le build Docker de livraison
BUILD_SHA=development
# Tests Redis réels uniquement sur un backend de développement/CI sélectionné
RUN_SHARED_BACKEND_TESTS=0
