# ===========================
# BASE DE DONNÉES
# ===========================
DB_HOST=db
DB_PORT=5432
DB_DATABASE=prosartisan
DB_USERNAME=prosartisan
DB_PASSWORD=changeme_in_production

# ===========================
# REDIS
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# ===========================
# QDRANT (Base Vectorielle)
# ===========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=connaissances_prosartisan

# ===========================
# API LLM (OpenAI)
# ===========================
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ===========================
# PAIEMENT MOBILE MONEY
# ===========================
WAVE_API_KEY=wave_sk_live_your_key_here
MOBILE_MONEY_SECRET_KEY=your_hmac_secret_key_here

# ===========================
# APPLICATION
# ===========================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme_generate_a_random_string
JWT_SECRET_KEY=changeme_generate_another_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ===========================
# QUOTAS FREEMIUM
# ===========================
MAX_QUESTIONS_GRATUITES_PAR_JOUR=5
