# ===========================
# BASE DE DONNÉES
# ===========================
# DB_HOST=db en Docker Compose, DB_HOST=localhost pour un dev hors conteneur
DB_HOST=db
DB_PORT=5432
DB_DATABASE=prosartisan
DB_USERNAME=prosartisan
DB_PASSWORD=changeme_in_production
# true = interdit le repli SQLite (forcé automatiquement si APP_ENV=production)
DB_REQUIRE_POSTGRES=false
# true = journalise toutes les requêtes SQL (verbeux, dev uniquement)
DB_ECHO=false
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ===========================
# REDIS
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# ===========================
# QDRANT (Base Vectorielle)
# ===========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=connaissances_prosartisan

# ===========================
# API LLM (Mistral)
# ===========================
MISTRAL_API_KEY=your-mistral-key-here
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
LLM_MODEL=mistral-small-latest
LLM_VISION_MODEL=mistral-medium-latest
STT_MODEL=voxtral-mini-latest
TTS_MODEL=voxtral-mini-tts-2603
# Identifiant de la voix Voxtral TTS — préréglage "Marie - Neutral" (français)
# fourni par Mistral par défaut, aucun clonage requis. Autres préréglages :
# GET https://api.mistral.ai/v1/audio/voices?type=preset (dont fr_marie_sad,
# fr_marie_happy, fr_marie_excited, fr_marie_curious, fr_marie_angry).
TTS_VOICE_ID=5a271406-039d-46fe-835b-fbbb00eaf08d
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=mistral-embed

# ===========================
# PAIEMENT MOBILE MONEY
# ===========================
WAVE_API_KEY=wave_sk_live_your_key_here
MOBILE_MONEY_SECRET_KEY=your_hmac_secret_key_here

# ===========================
# COMPTE ADMIN INITIAL (seed)
# ===========================
# En production, ADMIN_PASSWORD est obligatoire pour créer le compte admin.
# Hors production, un mot de passe de dev est utilisé si celui-ci est vide.
ADMIN_EMAIL=admin@prosartisan.ci
ADMIN_PASSWORD=

# ===========================
# APPLICATION
# ===========================
# APP_ENV=production impose des secrets forts + CORS explicite + APP_DEBUG=false
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme_generate_a_random_string
JWT_SECRET_KEY=changeme_generate_another_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
# Origines autorisées (séparées par des virgules). '*' interdit en production.
CORS_ALLOWED_ORIGINS=*
# Nombre de reverse proxies de confiance devant l'API (lecture de l'IP client
# dans X-Forwarded-For, de droite à gauche). 0 = connexion directe (dev).
# Caddy (docker-compose.prod.yml), Render, Cloud Run : 1.
TRUSTED_PROXY_HOPS=0

# ===========================
# QUOTAS FREEMIUM
# ===========================
# Quota gratuit par jour (UTC = heure d'Abidjan), compté dans Redis par
# utilisateur connecté ou par IP pour un visiteur anonyme. Remis à zéro chaque
# jour automatiquement ; les crédits achetés (Pack 50) s'y ajoutent.
MAX_QUESTIONS_GRATUITES_PAR_JOUR=5

# ===========================
# NOTIFICATIONS PUSH (Firebase Cloud Messaging — mobile, API HTTP v1)
# ===========================
# Chemin vers le JSON du compte de service Firebase (Console Firebase >
# Paramètres du projet > Comptes de service > Générer une nouvelle clé privée).
# Ne JAMAIS committer ce fichier (voir .gitignore) — placez-le par ex. dans
# secrets/firebase-service-account.json. Vide = provider push en no-op journalisé.
FCM_SERVICE_ACCOUNT_PATH=

# ===========================
# NOTIFICATIONS WEB PUSH (VAPID — chat_web)
# ===========================
# Fonctionne dès le départ avec la paire de dev intégrée par défaut (aucun
# compte tiers requis, contrairement à FCM). Régénérer en production avec :
#   python -c "from py_vapid import Vapid02; from cryptography.hazmat.primitives import serialization; import base64; v=Vapid02(); v.generate_keys(); priv=v.private_key.private_numbers().private_value.to_bytes(32,'big'); pub=v.public_key.public_bytes(encoding=serialization.Encoding.X962, format=serialization.PublicFormat.UncompressedPoint); print('VAPID_PRIVATE_KEY='+base64.urlsafe_b64encode(priv).rstrip(b'=').decode()); print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(pub).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=contact@prosartisan.ci
